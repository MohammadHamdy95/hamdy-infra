# Hostname → container routing. TLS terminates at Cloudflare; the tunnel
# delivers plain HTTP to Caddy, so sites are declared as http://.

# hamdy.app — flagship portfolio
http://hamdy.app {
    reverse_proxy hamdy-app:80
}

# tiny.hamdy.app — URL shortener: / → UI, /api/* and /:slug → backend
http://tiny.hamdy.app {
    handle /api/* {
        reverse_proxy tiny-backend:8080
    }
    @frontend path / /assets/* /favicon.svg /icons.svg
    handle @frontend {
        reverse_proxy tiny-frontend:80
    }
    handle {
        reverse_proxy tiny-backend:8080
    }
}

# paste.hamdy.app — /v1/* → API, everything else → UI (same-origin,
# no CORS; Cloudflare's free-plan cert only covers one subdomain level
# so api.paste.hamdy.app was never an option)
http://paste.hamdy.app {
    handle /v1/* {
        reverse_proxy paste-backend:8080
    }
    handle {
        reverse_proxy paste-frontend:80
    }
}

# docs.hamdy.app — OpenShare: /api/* → API, everything else → static SPA
http://docs.hamdy.app {
    handle /api/* {
        reverse_proxy apidocs-backend:8080
    }
    handle {
        reverse_proxy apidocs-frontend:80
    }
}

# panel.hamdy.app — Pterodactyl. Lives in its own stack (see
# pterodactyl/compose.yaml) but joins this stack's `web` network, so it
# resolves by service name like any local container.
http://panel.hamdy.app {
    reverse_proxy panel:80
}

# node.hamdy.app — Pterodactyl Wings. Wings runs on the HOST, not in a
# container, so this crosses the bridge to the host gateway rather than
# naming a service. Port 8081 because Pi-hole's admin UI already has 8080.
#
# Carries the browser's console websocket as well as the panel's API calls;
# Caddy and Cloudflare both upgrade these transparently, so no extra config.
# Uploads through here are capped at 100 MB by Cloudflare's free plan — use
# SFTP on the LAN for anything larger.
http://node.hamdy.app {
    reverse_proxy 172.17.0.1:8081
}
