# Copy to .env (gitignored) and fill in. Never commit real values.
#
# This stack has its own .env, separate from ../.env — docker compose loads
# the .env sitting next to the compose file it's given.

# Panel database credentials. Any long random values; nothing else uses
# them and they never leave the internal Docker network. Generate with:
#   openssl rand -base64 32
PTERO_DB_PASSWORD=
PTERO_DB_ROOT_PASSWORD=

# Shown as the author on eggs you create in the panel. Must be a valid
# email address — the panel validates it.
PTERO_SERVICE_AUTHOR=

# Cloudflare token for the ddns container, which keeps mc.hamdy.app
# pointed at this house's IP. Needs only Zone:DNS:Edit on hamdy.app.
#
# Reusing the main CLOUDFLARE_API_TOKEN works but is broader than this
# container needs — it can edit every record in the zone, and it lives
# unencrypted in a long-running container. A dedicated token scoped to
# hamdy.app DNS only is the better shape when you get a moment.
CF_DDNS_TOKEN=
