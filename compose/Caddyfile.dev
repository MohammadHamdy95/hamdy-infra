# Local dev routing — mirrors prod hostnames on *.localhost.
# Browsers resolve *.localhost to 127.0.0.1 automatically.

http://hamdy.localhost {
    reverse_proxy hamdy-app:80
}

# tiny.localhost — URL shortener: / → UI, /api/* → backend, /:slug → redirect
http://tiny.localhost {
    handle /api/* {
        reverse_proxy tiny-backend:8080
    }
    @frontend path / /assets/* /favicon.svg /icons.svg
    handle @frontend {
        reverse_proxy tiny-frontend:80
    }
    handle {
        reverse_proxy tiny-backend:8080
    }
}

# paste.localhost — /v1/* → API, everything else → UI (same-origin, like prod)
http://paste.localhost {
    handle /v1/* {
        reverse_proxy paste-backend:8080
    }
    handle {
        reverse_proxy paste-frontend:80
    }
}

# docs.localhost — OpenShare API documentation publishing service
http://docs.localhost {
    handle /api/* {
        reverse_proxy apidocs-backend:8080
    }
    handle {
        reverse_proxy apidocs-frontend:80
    }
}
