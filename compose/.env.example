# Copy to .env (gitignored) and fill in. Never commit real values.
# See ../.env.example for where each of these comes from.
TUNNEL_TOKEN=

# The tiny-backend service maps these to the container's
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY — this is the narrow IAM
# user terraform/aws creates, NOT your own AWS credentials.
TINY_AWS_ACCESS_KEY_ID=
TINY_AWS_SECRET_ACCESS_KEY=
