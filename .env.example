# Master secrets reference for the whole hamdy.app platform.
#
# Copy to `.env` (gitignored) and fill in. This file is plaintext on your
# own machine only — never commit it, never copy it to the server as-is
# without checking what actually needs to be there (see notes per section).
#
# This file is a REFERENCE, not auto-loaded by anything. The two real
# consumers each get their own copy of the relevant subset:
#   - compose/.env      → auto-loaded by `docker compose` (see compose/.env.example)
#   - your shell, ad-hoc → exported before `terraform apply` (see notes below)
#
# IMPORTANT: the two AWS credential pairs below are DIFFERENT IDENTITIES
# with different privilege levels. Never export both as the same
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY pair in one shell/container —
# doing so could run the shortener app with your broad deployer
# credentials instead of its narrow least-privilege ones.

# ── Cloudflare ────────────────────────────────────────────────────────
# Used by: terraform/cloudflare (the Cloudflare provider reads this exact
# env var name automatically). Dashboard → My Profile → API Tokens.
# Needs: Zone:DNS:Edit, Account:Cloudflare Tunnel:Edit.
CLOUDFLARE_API_TOKEN=

# Non-secret Cloudflare ids (account_id, zone_id) are NOT here — they go
# in terraform/cloudflare/terraform.tfvars (see terraform.tfvars.example).

# ── AWS — deployer identity ──────────────────────────────────────────
# Used by: `terraform apply` in terraform/aws, run from your own machine.
# This identity needs permission to create/manage the DynamoDB table and
# the shortener's IAM user/policy/access-key — use a personal IAM user
# scoped to that, not your AWS root credentials.
# Export just these two before running terraform (do NOT put them in
# compose/.env):
#   export AWS_ACCESS_KEY_ID=$TF_DEPLOYER_AWS_ACCESS_KEY_ID
#   export AWS_SECRET_ACCESS_KEY=$TF_DEPLOYER_AWS_SECRET_ACCESS_KEY
TF_DEPLOYER_AWS_ACCESS_KEY_ID=
TF_DEPLOYER_AWS_SECRET_ACCESS_KEY=

# ── AWS — tiny-backend runtime identity ─────────────────────────
# Used by: the tiny-backend container (compose/.env → mapped to
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY inside the container).
# This is the NARROW IAM user terraform/aws creates (links table only) —
# get the values from its Terraform outputs after applying terraform/aws:
#   terraform output tiny_access_key_id
#   terraform output -raw tiny_secret_access_key
TINY_AWS_ACCESS_KEY_ID=
TINY_AWS_SECRET_ACCESS_KEY=

# ── Cloudflare Tunnel ─────────────────────────────────────────────────
# Used by: the cloudflared container (compose/.env). Get this from
# terraform/cloudflare's output after applying:
#   terraform output -raw tunnel_token
TUNNEL_TOKEN=

# ── OpenShare PostgreSQL ─────────────────────────────────────────────
# Used only by the apidocs-backend and apidocs-postgres containers.
# Put this value in compose/.env. Generate it once with:
#   openssl rand -base64 32
APIDOCS_POSTGRES_PASSWORD=

# ── Pterodactyl (game servers) ────────────────────────────────────────
# Used by: compose/pterodactyl/.env — that stack has its OWN .env file,
# separate from compose/.env, because docker compose loads the .env next
# to the compose file it is given. See compose/pterodactyl/.env.example.
#
# The two database passwords are self-chosen (openssl rand -base64 32);
# nothing outside the stack's internal network ever sees them.
PTERO_DB_PASSWORD=
PTERO_DB_ROOT_PASSWORD=
PTERO_SERVICE_AUTHOR=

# Cloudflare token for the cloudflare-ddns container, which keeps the
# unproxied cosmosworld.hamdy.app record pointed at the current home IP (see
# decisions/0002). Needs only Zone:DNS:Edit on hamdy.app — narrower than
# CLOUDFLARE_API_TOKEN above, which also carries tunnel permissions.
# Currently the same value is reused; a dedicated scoped token is the
# better shape and is a pending cleanup.
CF_DDNS_TOKEN=

# ── CI (GitHub Actions) ───────────────────────────────────────────────
# NOT stored here. Each repo's GitHub Actions secrets hold what CI needs
# (e.g. GHCR push credentials) — configure those in each repo's Settings
# → Secrets, never in a committed file.
